<header id="masthead" class="site-header">
    <div id="topBar">
        <div class="grid-container">
            <div class="grid-x grid-padding-collapse align-middle">
                <!-- Accessibility -->
                <div class="access cell small-1 medium-1">
                    Accessibility
                </div>
                <div id="accessMenu" class="cell">
                    <h3>Accessibility options</h3>
                    <div class="grid-x grid-margin-x grid-margin-y">
                        <div class="cell medium-6">
                            <h4>Font size</h4>
                            <span class="wp_user_stylesheet_switcher">
                                <button class="wp_user_stylesheet_switcher_button wp_user_stylesheet_switcher_icon_s1_0 wp_user_stylesheet_switcher_active_option" onclick="wp_user_stylesheet_switcher_changeCSS('s1', '0');">
                                    <img class="wp_user_stylesheet_switcher_icon" src="/assets/theme/img/font.svg" alt="Default Font">
                                </button>
                                <button class="wp_user_stylesheet_switcher_button wp_user_stylesheet_switcher_icon_s1_1" onclick="wp_user_stylesheet_switcher_changeCSS('s1', '1');">
                                    <img class="wp_user_stylesheet_switcher_icon" src="/assets/theme/img/font.svg" alt="Medium Font">
                                </button>
                                <button class="wp_user_stylesheet_switcher_button wp_user_stylesheet_switcher_icon_s1_2" onclick="wp_user_stylesheet_switcher_changeCSS('s1', '2');">
                                    <img class="wp_user_stylesheet_switcher_icon" src="/assets/theme/img/font.svg" alt="Large Font">
                                </button>
                            </span>
                        </div>
                        <div class="cell medium-6">
                            <h4>Contrast</h4>
                            <div class="wp_user_stylesheet_switcher">
                                <select name="user_stylesheet_switcher_choice_dropdown_s0" onchange="wp_user_stylesheet_switcher_changeCSS('s0', this.value);">
                                    <option value="0">Low Contrast</option>
                                    <option selected="selected" value="1">Default Contrast</option>
                                    <option value="2">High Contrast</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div id="saveOptions" class="grid-x grid-padding-collapse">
                        <div class="cell medium-12">
                            <a id="saveaccess" class="button" href="">Save options and close</a>
                            <p>To find out more about web accessibility, and the accessibility features of this site, please visit our <u><a href="/accessing-this-website/">web accessibility page</a>.</u></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="menuBar" class="grid-container">
        <div class="grid-x grid-padding-x align-middle">
            <div class="subhead cell small-8 medium-6 large-4 small-order-2 medium-order-1">
                <a href="/" rel="home" class="site-title">
                    Explore Toynbee Hall
                </a>
            </div>

            <nav id="site-navigation" class="main-navigation cell small-2 small-offset-2 medium-1 medium-offset-0 large-6 small-order-3 large-order-2">
                <button class="menu-toggle" aria-controls="primary-menu" aria-expanded="false">
                    <img src="/assets/theme/img/menu.svg" alt="Menu"/>
                    <img style="display:none" src="/assets/theme/img/close.svg" alt="Close"/>
                </button>
                <div class="menu-top-menu-container">
                    <ul id="primary-menu" class="menu">
                        {% for item in navigation.main %}
                        <li id="menu-item-{{ loop.index }}" class="menu-item{% if item.children %} menu-item-has-children{% endif %}{% if page.url == item.url %} current-menu-item{% endif %}">
                            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
                            {% if item.children %}
                            <ul class="sub-menu">
                                {% for child in item.children %}
                                <li class="menu-item">
                                    <a href="{{ child.url }}">{{ child.title }}</a>
                                </li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </nav>

            <div id="logo" class="cell small-6 small-offset-6 medium-3 medium-offset-2 large-2 large-offset-0 small-order-1 large-order-3">
                <a href="/" rel="home">
                    <img src="{{ site.logo }}" alt="Toynbee Hall"/>
                </a>
            </div>
        </div>
    </div>
</header>
